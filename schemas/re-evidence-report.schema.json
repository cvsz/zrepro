{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cvsz/zrepro/schemas/re-evidence-report.schema.json",
  "title": "zRepro Reverse Engineering Evidence Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "scope", "findings", "evidence_state"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "type"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "type": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"]},
        "architecture": {"type": ["string", "null"]},
        "provenance": {"type": ["string", "null"]}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_objective", "environment"],
      "properties": {
        "authorized_objective": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["confirmed", "probable", "hypothesis"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "source"],
              "properties": {
                "kind": {"enum": ["static", "dynamic", "metadata", "provider"]},
                "source": {"type": "string", "minLength": 1},
                "tool": {"type": ["string", "null"]},
                "tool_version": {"type": ["string", "null"]},
                "command_or_method": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    },
    "evidence_state": {
      "enum": ["VERIFIED", "PARTIALLY VERIFIED", "UNVERIFIED", "BLOCKED", "NOT APPLICABLE"]
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_evidence_step": {"type": ["string", "null"]}
  }
}
