# Local development (loopback only)
ZREPRO_MCP_AUTH_MODE=local
ZREPRO_MCP_HOST=127.0.0.1
ZREPRO_MCP_PORT=8787
ZREPRO_ROOT=../..

# Production remote MCP:
# ZREPRO_MCP_AUTH_MODE=introspection
# ZREPRO_MCP_HOST=0.0.0.0
# ZREPRO_MCP_RESOURCE_URL=https://mcp.example.com/mcp
# ZREPRO_MCP_ISSUER_URL=https://idp.example.com/
# ZREPRO_MCP_INTROSPECTION_URL=https://idp.example.com/oauth2/introspect
# ZREPRO_MCP_INTROSPECTION_CLIENT_ID=secret-ref-only
# ZREPRO_MCP_INTROSPECTION_CLIENT_SECRET=secret-ref-only
# ZREPRO_MCP_REQUIRED_SCOPE=zrepro:read
